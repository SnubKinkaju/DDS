{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "titre",
    "description",
    "typeLogement",
    "capacite",
    "prixNuitCentimes",
    "adresse"
  ],
  "properties": {
    "equipements": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {"type": "integer", "minimum": 1}
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "typeLogement": {
      "type": "string",
      "enum": ["appartement", "maison", "chalet", "studio", "chambre"]
    },
    "capacite": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "prixNuitCentimes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "adresse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rue", "codePostal", "ville"],
      "properties": {
        "rue": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "codePostal": {
          "type": "string",
          "pattern": "^74220$"
        },
        "ville": {
          "const": "La Clusaz"
        }
      }
    }
  }
}
