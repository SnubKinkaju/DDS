{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["prenom", "nom", "email", "motDePasse"],
  "properties": {
    "prenom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "nom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "telephone": {
      "type": ["string", "null"],
      "maxLength": 30
    },
    "motDePasse": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  }
}
