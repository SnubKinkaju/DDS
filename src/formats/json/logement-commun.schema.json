{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refuge.example/api/formats/json/logement-commun.schema.json",
  "title": "Définitions communes aux documents de logement",
  "description": "Règles partagées par la saisie et la description publique d'un logement.",
  "$defs": {
    "identifiant": { "type": "integer", "minimum": 1 },
    "titre": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "typeLogement": {
      "type": "string",
      "enum": ["appartement", "maison", "chalet", "studio", "chambre"]
    },
    "capacite": { "type": "integer", "minimum": 1, "maximum": 20 },
    "prixNuitCentimes": {
      "description": "Prix d'une nuit en centimes d'euro, pour éviter les arrondis flottants.",
      "type": "integer", "minimum": 0, "maximum": 1000000
    },
    "adresse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rue", "codePostal", "ville"],
      "properties": {
        "rue": { "type": "string", "minLength": 3, "maxLength": 160 },
        "codePostal": { "type": "string", "pattern": "^74220$" },
        "ville": { "const": "La Clusaz" }
      }
    }
  }
}
